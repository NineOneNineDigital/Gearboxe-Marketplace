{
  "name": "gearboxe-market",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @gearboxe/web dev",
    "dev:admin": "pnpm --filter @gearboxe/admin dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gearboxe/web test && pnpm --filter @workspace/design-tokens test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:tokens": "pnpm --filter @workspace/design-tokens typecheck && pnpm --filter @workspace/design-tokens test",
    "convex:dev": "pnpm --filter @gearboxe/web exec convex dev",
    "convex:deploy": "pnpm --filter @gearboxe/web exec convex deploy"
  }
}
