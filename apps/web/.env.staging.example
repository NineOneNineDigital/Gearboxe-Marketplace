# Gearboxe staging web project: Vercel Production environment, branch dev.
# These are fake values. Replace every REPLACE marker before deploying.
# Do not import this file into the existing marketplace production project.

STAGING_SHARED_DEV_BACKEND=true
MARKETPLACE_ENV=staging

# Use the same existing non-production Convex dev deployment for all three values.
CONVEX_DEPLOYMENT=dev:REPLACE_WITH_DEV_DEPLOYMENT
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_WITH_DEV_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://REPLACE_WITH_DEV_DEPLOYMENT.convex.site

# Use the matching keys from the existing Clerk development application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEV_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_DEV_SECRET_KEY

# Use the exact HTTPS origin assigned to the separate staging Vercel project.
NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_STAGING_PROJECT.vercel.app

NEXT_PUBLIC_POPUP_PAYMENTS_ENABLED=false
NEXT_PUBLIC_OFFERS_ENABLED=false

# Optional only after a separate staging admin portal exists:
# NEXT_PUBLIC_ADMIN_PORTAL_URL=https://REPLACE_WITH_STAGING_ADMIN_PROJECT.vercel.app

# Vercel supplies VERCEL, VERCEL_ENV, and VERCEL_GIT_COMMIT_REF automatically.
# Do not set CONVEX_DEPLOY_KEY or EXPECTED_CONVEX_DEPLOYMENT here.
