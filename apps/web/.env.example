# Copy to .env.local for development. Never commit actual credentials.
MARKETPLACE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEV-DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEV-DEPLOYMENT.convex.site
CONVEX_DEPLOYMENT=dev:YOUR-DEV-DEPLOYMENT
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Confirm the approved event fee; do not copy this example price into production.
EVENT_REGISTRATION_PRICE_CENTS=1000
# Configure separately in the Convex dashboard, NOT automatically loaded there:
