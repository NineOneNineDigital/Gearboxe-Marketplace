# Copy to .env.local for development. Never commit actual credentials.
MARKETPLACE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set the unified admin portal origin when available.
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEV-DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEV-DEPLOYMENT.convex.site
CONVEX_DEPLOYMENT=dev:YOUR-DEV-DEPLOYMENT
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Confirm the approved event fee; do not copy this example price into production.
EVENT_REGISTRATION_PRICE_CENTS=4900
# Configure separately in the Convex dashboard, NOT automatically loaded there:
# MARKETPLACE_ENV, CLERK_JWT_ISSUER_DOMAIN, CLERK_WEBHOOK_SECRET,
# STRIPE_SECRET_KEY, EVENT_REGISTRATION_PRICE_CENTS

# Convex deployment: VIN_DECODER_PROVIDER=auto_dev or vpic.
# Auto.dev requires AUTO_DEV_API_KEY in Convex only; vPIC needs no key.
# Media uploads require APP_URL (exact web origin) in the Convex deployment.
# CONVEX_SITE_URL is supplied automatically by Convex.

# Notification delivery runs in Convex, configure there only:
# AUTOSEND_API_KEY, AUTOSEND_FROM_EMAIL, AUTOSEND_WEBHOOK_SECRET
# AUTOSEND_FROM_NAME is optional. APP_URL must be the exact web origin.
# See docs/NOTIFICATIONS.md for verified sender, webhook and unsubscribe setup.

# Event Checkout reads its fee from Convex EVENT_REGISTRATION_PRICE_CENTS.
# Convex also requires APP_URL and STRIPE_WEBHOOK_SECRET matching this deployment.
